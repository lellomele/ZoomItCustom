#include "version.h"
#include <windows.h>
APPICON ICON "../assets/supervisor.ico"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION FILE_VERSION
 PRODUCTVERSION PRODUCT_VERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", COMPANY_NAME
   VALUE "FileDescription", "ZoomIt Custom Supervisor"
   VALUE "FileVersion", FILE_VERSION_STRING
   VALUE "InternalName", "ZoomItCustomSupervisor"
   VALUE "LegalCopyright", COPYRIGHT_NOTE
   VALUE "OriginalFilename", "ZoomItCustomSupervisor.exe"
   VALUE "ProductName", "ZoomIt Custom Supervisor"
   VALUE "ProductVersion", PRODUCT_VERSION_STRING
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
