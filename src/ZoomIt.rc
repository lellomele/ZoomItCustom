            VALUE "OriginalFilename", ORIGINAL_FILENAME
            VALUE "ProductName", ZOOMIT_PRODUCT_NAME
            VALUE "ProductVersion", PRODUCT_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
