OPTIONS DIALOGEX 0, 0, 279, 429
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CLIPSIBLINGS | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "ZoomIt Custom"
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,166,409,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,223,409,50,14
    LTEXT           "ZoomIt Custom",IDC_VERSION,42,8,223,10
    LTEXT           "Screen magnification and annotation",IDC_STATIC,42,23,223,10
    ICON            "APPICON",IDC_STATIC,12,9,20,20
    CONTROL         "Show tray icon",IDC_SHOW_TRAY_ICON,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,313,105,10
    CONTROL         "",IDC_TAB,"SysTabControl32",TCS_MULTILINE | WS_TABSTOP,8,46,265,263
    LTEXT           "",IDC_SUPERVISION_STATUS,126,313,147,10
    GROUPBOX        "Avvio automatico (all'accesso a Windows)",IDC_STATIC,8,327,265,58
    CONTROL         "Disattivato",IDC_STARTUP_OFF,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,16,340,248,10
    CONTROL         "Avvia ZoomIt Custom con Windows",IDC_STARTUP_NORMAL,"Button",BS_AUTORADIOBUTTON,16,353,248,10
    CONTROL         "Avvia ZoomIt Custom con supervisore",IDC_STARTUP_SUPERVISED,"Button",BS_AUTORADIOBUTTON,16,366,248,10
    LTEXT           "",IDC_STARTUP_HINT,13,389,260,18
END

ADVANCED_BREAK DIALOGEX 0, 0, 209, 219
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Advanced Break Options"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "Play Sound on Expiration:",IDC_CHECK_SOUND_FILE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,3,11,98,10,WS_EX_RIGHT
    EDITTEXT        IDC_SOUND_FILE,61,38,125,12,ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON      "&...",IDC_SOUND_BROWSE,187,38,13,11
    COMBOBOX        IDC_OPACITY,62,58,38,30,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "",IDC_TIMER_POS1,"Button",BS_AUTORADIOBUTTON,63,78,10,10
    CONTROL         "",IDC_TIMER_POS2,"Button",BS_AUTORADIOBUTTON,79,78,10,10
    CONTROL         "",IDC_TIMER_POS3,"Button",BS_AUTORADIOBUTTON,97,78,10,10
    CONTROL         "",IDC_TIMER_POS4,"Button",BS_AUTORADIOBUTTON,63,93,10,10
    CONTROL         "",IDC_TIMER_POS5,"Button",BS_AUTORADIOBUTTON,79,93,10,10
    CONTROL         "",IDC_TIMER_POS6,"Button",BS_AUTORADIOBUTTON,97,93,10,10
    CONTROL         "",IDC_TIMER_POS7,"Button",BS_AUTORADIOBUTTON,63,108,10,10
    CONTROL         "",IDC_TIMER_POS8,"Button",BS_AUTORADIOBUTTON,79,108,10,10
    CONTROL         "",IDC_TIMER_POS9,"Button",BS_AUTORADIOBUTTON,97,108,10,10
    CONTROL         "Show background bitmap:",IDC_CHECK_BACKGROUND_FILE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,3,122,99,10,WS_EX_RIGHT
    CONTROL         "Use faded desktop as background",IDC_STATIC_DESKTOP_BACKGROUND,
                    "Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,46,135,125,10
    CONTROL         "Use image file as background",IDC_STATIC_BACKGROUND_FILE,
                    "Button",BS_AUTORADIOBUTTON | WS_TABSTOP,46,149,109,10
    EDITTEXT        IDC_BACKGROUND_FILE,62,164,125,12,ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON      "&...",IDC_BACKGROUND_BROWSE,188,164,13,11
    CONTROL         "Scale to screen:",IDC_CHECK_BACKGROUND_STRETCH,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,58,180,67,10,WS_EX_RIGHT
    DEFPUSHBUTTON   "OK",IDOK,97,201,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,150,201,50,14
    LTEXT           "Alarm Sound File:",IDC_STATIC_SOUND_FILE,61,26,56,8
    LTEXT           "Timer Opacity:",IDC_STATIC,8,59,48,8
    LTEXT           "Timer Position:",IDC_STATIC,8,77,48,8
    CONTROL         "",IDC_STATIC,"Static",SS_BLACKFRAME | SS_SUNKEN,7,196,193,1,WS_EX_CLIENTEDGE
END

ZOOM DIALOGEX 0, 0, 260, 158
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD | WS_CLIPSIBLINGS | WS_SYSMENU
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_HOTKEY,"msctls_hotkey32",WS_BORDER | WS_TABSTOP,59,57,80,12
    LTEXT           "After toggling ZoomIt you can zoom in with the mouse wheel or up and down arrow keys. Exit zoom mode with Escape or by pressing the right mouse button.",IDC_STATIC,7,6,246,26
    LTEXT           "Zoom Toggle:",IDC_STATIC,7,59,51,8
    CONTROL         "",IDC_ZOOM_SLIDER,"msctls_trackbar32",TBS_AUTOTICKS | TBS_BOTH | TBS_NOTICKS | WS_TABSTOP,53,104,150,15,WS_EX_TRANSPARENT
    LTEXT           "Specify the initial level of magnification when zooming in:",IDC_STATIC,7,91,215,10
    LTEXT           "1.25",IDC_STATIC,52,122,16,8
    LTEXT           "1.5",IDC_STATIC,82,122,12,8
    LTEXT           "1.75",IDC_STATIC,108,122,16,8
    LTEXT           "2.0",IDC_STATIC,138,122,12,8
    LTEXT           "3.0",IDC_STATIC,164,122,12,8
    LTEXT           "4.0",IDC_STATIC,190,122,12,8
    CONTROL         "Animate zoom in and zoom out:",IDC_ANIMATE_ZOOM,"Button",BS_AUTOCHECKBOX | BS_LEFTTEXT | WS_TABSTOP,7,74,116,10
    LTEXT           "Ctrl+C / Ctrl+S: copy / save. Ctrl+Shift+C / Ctrl+Shift+S: copy / save a region. Draw and LiveDraw hotkeys are ignored in Zoom.",IDC_STATIC,7,34,246,17
END

DRAW DIALOGEX 0, 0, 260, 246
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD | WS_SYSMENU
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Draw freezes the desktop or LiveZoom. Right-click pauses (ring pointer); left-click resumes. Right-click again or press Escape to exit. Other mode hotkeys are ignored while drawing, even when paused.",IDC_STATIC,7,7,246,32
    LTEXT           "Pen Control ",IDC_PEN_CONTROL,7,44,40,8
    LTEXT           "Change the pen width with left Ctrl + mouse wheel or Up/Down. Center the pointer with the space bar.",IDC_STATIC,19,54,233,16
    LTEXT           "Colors",IDC_COLORS,7,75,21,8
    LTEXT           "Change the pen color with R (red), G (green), B (blue), O (orange), Y (yellow) or P (pink).",IDC_STATIC,19,85,233,16
    LTEXT           "Highlight and Blur",IDC_HIGHLIGHT_AND_BLUR,7,106,58,8
    LTEXT           "Shift + color: highlighter. X / Shift+X: blur / stronger blur. Highlight and blur are unavailable in LiveDraw.",IDC_STATIC,19,116,233,16
    LTEXT           "Shapes",IDC_SHAPES,7,137,23,8
    LTEXT           "Hold Shift for a line, Ctrl for a rectangle, Tab for an ellipse, or Shift+Ctrl for an arrow.",IDC_STATIC,19,147,233,16
    LTEXT           "Screen",IDC_SCREEN,7,168,22,8
    LTEXT           "Ctrl+Z: undo. E: erase. W / K: white / black background. Ctrl+C / Ctrl+S: copy / save. Ctrl+Shift+C / Ctrl+Shift+S: copy / save a region.",IDC_STATIC,19,178,233,24
    CONTROL         "",IDC_DRAW_HOTKEY,"msctls_hotkey32",WS_BORDER | WS_TABSTOP,96,213,80,12
    LTEXT           "Draw:",IDC_STATIC,7,215,84,10
    LTEXT           "LiveDraw:",IDC_STATIC,7,230,84,10
    LTEXT           "",IDC_LIVE_DRAW_HOTKEY,96,230,157,10
END



BREAK DIALOGEX 0, 0, 260, 123
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD | WS_SYSMENU
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_BREAK_HOTKEY,"msctls_hotkey32",WS_BORDER | WS_TABSTOP,52,67,80,12
    EDITTEXT        IDC_TIMER,31,86,31,13,ES_RIGHT | ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "",IDC_SPIN_TIMER,"msctls_updown32",UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS,45,86,11,12
    LTEXT           "minutes",IDC_STATIC,67,88,25,8
    PUSHBUTTON      "&Advanced",IDC_ADVANCED_BREAK,212,102,41,14
    LTEXT           "Use the hotkey below to start or restart the timer. Up/Down or the wheel change minutes; Left/Right change 10 seconds. Escape exits. Other mode hotkeys are ignored.",IDC_STATIC,7,7,246,33
    LTEXT           "Start Timer:",IDC_STATIC,7,70,39,8
    LTEXT           "Timer:",IDC_STATIC,7,88,20,8
    LTEXT           "Use the drawing color keys for the timer. After Alt+Tab, click the tray icon to reactivate it.",IDC_STATIC,7,45,246,20
    CONTROL         "Show Time Elapsed After Expiration:",IDC_CHECK_SHOW_EXPIRED,
                    "Button",BS_AUTOCHECKBOX | BS_LEFTTEXT | WS_TABSTOP,8,104,132,10
END



LIVEZOOM DIALOGEX 0, 0, 260, 176
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD | WS_SYSMENU
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "LiveZoom mode is supported on updated Windows 10 and Windows 11 where window updates show while zoomed. ",IDC_STATIC,7,7,246,18
    LTEXT           "Ctrl+Up / Ctrl+Down change magnification. Draw (Ctrl+3 by default) freezes the view; Escape returns to LiveZoom. The Zoom hotkey is ignored, including while drawing.",IDC_STATIC,7,30,246,27
    LTEXT           "LiveDraw keeps the view live: use Draw + Shift (Ctrl+Shift+3 by default; see Draw tab). Escape ends drawing. Zoom, LiveZoom and timer hotkeys are ignored during Draw or LiveDraw, even when paused.",IDC_STATIC,7,62,246,32
    CONTROL         "Animate zoom in and zoom out:",IDC_ANIMATE_LIVE_ZOOM,"Button",BS_AUTOCHECKBOX | BS_LEFTTEXT | WS_TABSTOP,7,99,116,10
    LTEXT           "Smoothly magnify on entry and return to normal size on exit. Unchecked: change instantly.",IDC_STATIC,7,113,246,18
    LTEXT           "The hotkey below toggles LiveZoom when drawing is inactive.",IDC_STATIC,7,135,246,10
    LTEXT           "LiveZoom Toggle:",IDC_STATIC,7,151,62,8
    CONTROL         "",IDC_LIVE_HOTKEY,"msctls_hotkey32",WS_BORDER | WS_TABSTOP,69,149,80,12
    LTEXT           "",IDC_LIVE_STATUS,7,164,246,10
END


SNIP DIALOGEX 0, 0, 260, 106
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD | WS_CLIPSIBLINGS | WS_SYSMENU
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_SNIP_HOTKEY,"msctls_hotkey32",WS_BORDER | WS_TABSTOP,55,32,80,12
    LTEXT           "Snip Toggle:",IDC_STATIC,7,33,45,8
    LTEXT           "Copy a region with the hotkey below. Use it with Shift added or removed to save a PNG (Ctrl+Shift+5 by default).",IDC_STATIC,7,7,246,19
    LTEXT           "Snip works in Zoom, LiveZoom and Draw, including paused drawing. The drawing and its state are preserved. It is ignored during a stroke, the timer, or LiveDraw over LiveZoom.",IDC_STATIC,7,53,246,27
    LTEXT           "Mode hotkeys are ignored during selection, saving and options.",IDC_STATIC,7,87,246,10
END




ABOUT DIALOGEX 0, 0, 260, 228
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD | WS_CLIPSIBLINGS
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    ICON            "APPICON",IDC_STATIC,9,9,24,24
    LTEXT           "ZoomIt Custom",IDC_ABOUT_TITLE,42,10,211,12
    LTEXT           FILE_VERSION_STRING,IDC_ABOUT_VERSION,42,25,211,10
    LTEXT           "Screen magnification, drawing, LiveZoom and screen snips.",IDC_STATIC,7,46,246,18
    GROUPBOX        "Custom edition",IDC_STATIC,7,71,246,45
    LTEXT           "(C) 2026 Prof. ing. Raffaele Mele",IDC_ABOUT_COPYRIGHT,15,85,230,10
    CONTROL         "<a HREF=""https://github.com/lellomele/ZoomItCustom"">GitHub: lellomele/ZoomItCustom</a>",IDC_ABOUT_REPOSITORY,
                    "SysLink",WS_TABSTOP,15,100,230,10
    GROUPBOX        "Original software",IDC_STATIC,7,124,246,49
    LTEXT           "ZoomIt by Mark Russinovich",IDC_STATIC,15,138,230,10
    LTEXT           "Copyright (C) Mark Russinovich / Microsoft Corporation.",IDC_ABOUT_UPSTREAM,15,151,230,17
    GROUPBOX        "License",IDC_STATIC,7,181,246,40
    LTEXT           "MIT license. Original copyright notices are preserved.",IDC_STATIC,15,194,230,10
    CONTROL         "<a HREF=""https://github.com/lellomele/ZoomItCustom/blob/main/LICENSE"">License</a>    <a HREF=""https://github.com/microsoft/PowerToys/tree/21fd5092b3e062ca6c8dd6b8c772a236f90b3b42/src/modules/ZoomIt/ZoomIt"">Original source</a>",IDC_ABOUT_LICENSE,
                    "SysLink",WS_TABSTOP,15,208,230,10
END


